      "Bash(npx sanity@latest cors add --help)",
      "Bash(npx sanity@latest tokens add --help)",
      "Bash(npx sanity@latest tokens add \"Website \\(funkypressons.com\\)\" --role editor -p tkdcotec --json -y)",
      "Bash(node -e ' *)",
